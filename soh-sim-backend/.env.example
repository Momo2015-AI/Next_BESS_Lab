# =============================================================================
# SOH-SIM Backend 环境变量配置
# 复制此文件为 .env 并填入实际值（.env 已加入 .gitignore，不会提交到仓库）
# =============================================================================

# --- 必填 ---
# JWT 签名密钥（生产环境必须设置，否则拒绝启动）
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# --- 数据库 ---
# 默认使用 SQLite（开发/测试）
# 生产环境请改为 PostgreSQL 连接串:
#   DATABASE_URL=postgresql://user:password@host:5432/soh_sim
DATABASE_URL=sqlite:///soh_sim.db

# --- CORS ---
# 允许的前端来源，逗号分隔（生产环境请设置为实际域名）
CORS_ORIGINS=http://localhost:5173

# --- 日志 ---
# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# 日志文件路径（留空则仅输出到控制台）
LOG_FILE=

# --- 限流 ---
# 全局限流 (格式: "次数/时间单位")，生产环境可按需调整
RATELIMIT_DEFAULT=200 per day, 50 per hour

# --- 可选 ---
# Flask 环境: development | production | testing
FLASK_ENV=production
# 服务端口
PORT=5000
