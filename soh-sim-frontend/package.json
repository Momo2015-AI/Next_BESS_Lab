{
  "name": "soh-sim-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix",
    "lint:no-fix": "eslint src/ --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{vue,js,ts,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{vue,js,ts,css,json}\"",
    "type-check": "vue-tsc --noEmit",
    "i18n:check": "node ../scripts/check-i18n.js",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "src/**/*.{vue,js,ts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "echarts": "^6.1.0",
    "lodash-es": "^4.17.21",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.12",
    "vue-eslint-parser": "^9.4.0",
    "vue-tsc": "^2.0.0"
  }
}
